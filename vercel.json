{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "headers": [
    {"source": "/a/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/img/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/(.*)\\.(png|svg|webmanifest|css)", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800"}]}
  ]
}
